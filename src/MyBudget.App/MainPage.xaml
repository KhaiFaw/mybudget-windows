<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyBudget.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyBudget.App"
    xmlns:vm="using:MyBudget.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppBackgroundBrush}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <NavigationView
        x:Name="RootNavigation"
        AlwaysShowHeader="False"
        CompactPaneLength="48"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        IsSettingsVisible="True"
        OpenPaneLength="224"
        PaneClosing="RootNavigation_PaneClosing"
        PaneDisplayMode="Auto"
        ExpandedModeThresholdWidth="1180"
        CompactModeThresholdWidth="760"
        PaneOpening="RootNavigation_PaneOpening"
        SelectionChanged="Navigation_SelectionChanged">

        <NavigationView.PaneHeader>
            <StackPanel Margin="8,14,0,18" Orientation="Horizontal" Spacing="10">
                <Border
                    Width="34"
                    Height="34"
                    Background="{ThemeResource AppAccentBrush}"
                    CornerRadius="10">
                    <Image Width="28" Height="28" Source="Assets/Square44x44Logo.scale-200.png" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                        Text="MyBudget" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                        Text="LOCAL BUDGET PLANNER" />
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="OverviewNavigationItem" Content="Today" IsSelected="True" Tag="Overview"><NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Activity" Tag="Transactions"><NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Bills" Tag="Bills"><NavigationViewItem.Icon><SymbolIcon Symbol="Calendar" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Budget" Tag="Plan">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Calculator" /></NavigationViewItem.Icon>
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Content="Future plan" Tag="Future plan" />
                    <NavigationViewItem Content="Insights" Tag="Reports" />
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>
            <NavigationViewItem Content="Goals" Tag="Goals"><NavigationViewItem.Icon><SymbolIcon Symbol="Favorite" /></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <StackPanel x:Name="PaneFooterContent" Margin="12,8,12,14" Spacing="3">
                <StackPanel x:Name="ExpandedPrivacyFooter" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon
                            FontSize="11"
                            Foreground="{ThemeResource AppAccentBrush}"
                            Glyph="&#xE73E;" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Text="Local by default" />
                    </StackPanel>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                        Text="No cloud account required" />
                </StackPanel>
                <Border
                    x:Name="FooterDivider"
                    Height="1"
                    Margin="0,8,0,6"
                    Background="{ThemeResource AppBorderBrush}" />
                <StackPanel
                    x:Name="CreatorAttributionRow"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Created by KhaiFaw"
                        Background="{ThemeResource AppAccentSoftBrush}"
                        BorderBrush="{ThemeResource AppAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        ToolTipService.ToolTip="Created by KhaiFaw">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                            Text="KF" />
                    </Border>
                    <StackPanel
                        x:Name="ExpandedCreatorAttribution"
                        VerticalAlignment="Center"
                        Spacing="0">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                            Text="Created by KhaiFaw" />
                        <TextBlock
                            FontSize="9"
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Text="ORIGINAL CREATOR MARK" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneFooter>

        <Grid Background="{ThemeResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="30,22,34,14" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        x:Name="SectionTitle"
                        Style="{StaticResource PageTitleStyle}"
                        Text="Overview" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource SecondaryTextStyle}"
                        x:Name="SectionDescription"
                        Text="See where your money is going, without sending it anywhere." />
                </StackPanel>
                <StackPanel
                    x:Name="MonthNavigation"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        AutomationProperties.Name="Previous month"
                        Command="{x:Bind ViewModel.PreviousMonthCommand}"
                        ToolTipService.ToolTip="Previous month">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.CurrentMonthCommand}" Content="{x:Bind ViewModel.SelectedMonthText, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="Next month"
                        Command="{x:Bind ViewModel.NextMonthCommand}"
                        ToolTipService.ToolTip="Next month">
                        <SymbolIcon Symbol="Forward" />
                    </Button>
                </StackPanel>
                <ToggleSwitch
                    x:Name="ThemeToggle"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Dark mode"
                    IsOn="{x:Bind ViewModel.IsDarkMode, Mode=OneWay}"
                    OffContent="Light"
                    OnContent="Dark"
                    Toggled="ThemeToggle_Toggled" />
            </Grid>

            <!-- Home: daily essentials first; setup stays out of the way. -->
            <ScrollViewer x:Name="OverviewView" Grid.Row="1" HorizontalScrollBarVisibility="Auto" SizeChanged="DailyView_SizeChanged">
                <StackPanel x:Name="DailyContent" Width="1000" MinWidth="760" MaxWidth="1160" Margin="30,4,34,28" Spacing="20">
                    <Border Padding="28" CornerRadius="22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#102725" />
                                <GradientStop Offset="0.65" Color="#0D5D52" />
                                <GradientStop Offset="1" Color="#0B8F75" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="13" Foreground="#C1F5E6" Text="{x:Bind ViewModel.TodayHeadingText, Mode=OneWay}" />
                                <TextBlock FontSize="14" Foreground="White" Text="Available after recorded spending and savings" />
                                <TextBlock FontSize="44" FontWeight="SemiBold" Foreground="White" Text="{x:Bind ViewModel.AvailableText, Mode=OneWay}" />
                                <TextBlock Foreground="#D5EEE5" TextWrapping="Wrap" Text="{x:Bind ViewModel.TodayContextText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#F2FFFFFF" Foreground="#102725" Padding="20,12" CornerRadius="12" Click="GoToTransactions_Click" Content="+ Add transaction" />
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ImportStatement_Click" Content="Import statement" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Income received" /><TextBlock FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{x:Bind ViewModel.IncomeText, Mode=OneWay}" /></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Spent this month" /><TextBlock FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{x:Bind ViewModel.SpentText, Mode=OneWay}" /></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Saved this month" /><TextBlock FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" Text="{x:Bind ViewModel.SavedText, Mode=OneWay}" /></StackPanel></Border>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Bills, taken care of" /><TextBlock TextWrapping="Wrap" Foreground="{ThemeResource AppAccentBrush}" Text="{x:Bind ViewModel.CurrentBillsCompletionText, Mode=OneWay}" /></StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Click="GoToBills_Click" Content="View bills" />
                            </Grid>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.NextBillText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Recent activity" /><Button HorizontalAlignment="Right" Click="ViewActivity_Click" Content="See all" /></Grid>
                            <TextBlock Visibility="{x:Bind ViewModel.EmptyTransactionsVisibility, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Text="Your spending will appear here. Add an entry or import a statement to get started." />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentTransactions, Mode=OneWay}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Padding="0,10" ColumnSpacing="18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding Note}" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding CategoryName}" /></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding AmountText}" /><TextBlock HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" Text="{Binding DateText}" /></StackPanel>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Income schedule &amp; starting balance">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Set a payday once. Received income can be corrected in Activity; carry-forward is calculated from your recorded history." />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <NumberBox x:Name="MonthlyIncomeNumberBox" Header="Monthly take-home amount" Minimum="0" SpinButtonPlacementMode="Hidden" Value="{x:Bind ViewModel.MonthlyIncomeAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <NumberBox Grid.Column="1" Header="Pay day" Minimum="1" Maximum="31" SmallChange="1" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.MonthlyIncomePayDay, Mode=TwoWay}" />
                                <ToggleSwitch Grid.Column="2" VerticalAlignment="Bottom" IsOn="{x:Bind ViewModel.IsMonthlyIncomeActive, Mode=TwoWay}" OffContent="Paused" OnContent="Repeats monthly" />
                            </Grid>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.MonthlyIncomeScheduleText, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="12"><Button Click="SaveMonthlyIncome_Click" Style="{StaticResource PrimaryActionButtonStyle}" Content="Save schedule" /><Button Click="ViewActivity_Click" Content="Manage received income" /></StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{x:Bind ViewModel.CarryForwardText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.CarryForwardContextText, Mode=OneWay}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Plan -->
            <ScrollViewer x:Name="PlanView" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Margin="30,4,34,28" Spacing="18">
                    <Border Background="{ThemeResource AppAccentSoftBrush}" BorderBrush="{ThemeResource AppAccentBrush}" BorderThickness="1" CornerRadius="18" Padding="20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Give every ringgit a job" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Set a planned amount for each category. Savings stay separate from spending so your progress remains honest." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="REMAINING TO PLAN" />
                                <TextBlock HorizontalAlignment="Right" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" Text="{x:Bind ViewModel.RemainingToPlanText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12" Padding="4,0,4,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="CATEGORY" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="PLANNED" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" Text="ACTUAL" />
                                <TextBlock Grid.Column="3" Style="{StaticResource SecondaryTextStyle}" Text="REMAINING" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2" Padding="4,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding Name}" />
                                            <NumberBox Grid.Column="1" Minimum="0" SmallChange="10" SpinButtonPlacementMode="Compact" Value="{Binding PlannedAmount, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding ActualText}" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource AppTextSecondaryBrush}" Text="{Binding RemainingText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryActionButtonStyle}" Command="{x:Bind ViewModel.SavePlanCommand}" Content="Save monthly plan" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Future planning is deliberately separate from received income and spending. -->
            <ScrollViewer x:Name="FuturePlanView" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" SizeChanged="FuturePlanView_SizeChanged">
                <StackPanel x:Name="FuturePlanContent" MinWidth="960" Width="960" Margin="30,4,34,28" Spacing="18">
                    <Border Padding="24" CornerRadius="18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#102725" />
                                <GradientStop Offset="0.58" Color="#0D5D52" />
                                <GradientStop Offset="1" Color="#0B8F75" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Spacing="8">
                            <TextBlock Text="A plan for your next chapter" FontSize="26" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="ESTIMATES · NOT MONEY RECEIVED OR SPENT" FontSize="11" CharacterSpacing="100" Foreground="#C1F5E6" />
                            <TextBlock Text="{x:Bind Planning.IncomeContext, Mode=OneWay}" TextWrapping="Wrap" Foreground="White" />
                            <TextBlock Text="{x:Bind Planning.ContextText, Mode=OneWay}" TextWrapping="Wrap" Foreground="#D5EEE5" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Reload private plan" Command="{x:Bind Planning.ReloadCommand}" />
                        <Button Content="Import local planning file" Click="ImportPlanning_Click" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Planning.StatusText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind Planning.EmptyVisibility, Mode=OneWay}">
                        <TextBlock Text="No planning profile has been added on this PC. Import a private planning file to compare estimates. Plans never add salary deposits or overwrite transactions." Style="{StaticResource SecondaryTextStyle}" />
                    </Border>
                    <StackPanel Spacing="18" Visibility="{x:Bind Planning.ProfileVisibility, Mode=OneWay}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Full month · current costs" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{x:Bind Planning.FullIncomeSourceLabel, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                                    <TextBlock Text="{x:Bind Planning.CurrentFullSummary, Mode=OneWay}" FontSize="18" Foreground="{ThemeResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" BorderBrush="{ThemeResource AppAccentBrush}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Full month · proposed change" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="SUBSCRIPTION CHANGE NOT CONFIRMED" Foreground="{ThemeResource AppAccentBrush}" FontSize="11" />
                                    <TextBlock Text="{x:Bind Planning.ProposedFullSummary, Mode=OneWay}" FontSize="18" Foreground="{ThemeResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{x:Bind Planning.FirstMonthHeading, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{x:Bind Planning.FirstMonthContext, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Current subscription" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Planning.CurrentFirstSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="Proposed subscription · conditional" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" />
                                        <TextBlock Text="{x:Bind Planning.ProposedFirstSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <ComboBox Header="Inspect an allocation" ItemsSource="{x:Bind Planning.Choices, Mode=OneWay}" DisplayMemberPath="Label" SelectedItem="{x:Bind Planning.SelectedChoice, Mode=TwoWay}" MinWidth="360" />
                                <TextBlock Text="{x:Bind Planning.ScenarioHeading, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{x:Bind Planning.ScenarioBalanceText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Planning.EssentialsContextText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource AppAccentBrush}" />
                                <TextBlock Text="{x:Bind Planning.OriginalContext, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                <Grid ColumnSpacing="14" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="125" /><ColumnDefinition Width="125" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Allocation / basis" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Original full month" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="This scenario" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Actual" FontWeight="SemiBold" ToolTipService.ToolTip="Blank means not supplied; it does not mean zero." />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind Planning.Comparisons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlanningComparisonRow">
                                            <Border Padding="0,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource AppBorderBrush}">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="125" /><ColumnDefinition Width="125" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Basis}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Original}" Style="{StaticResource SecondaryTextStyle}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Planned}" Foreground="{ThemeResource AppAccentBrush}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind Actual}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind Planning.ScenarioTargetText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Planning.CalendarFoodText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Your split, not a forced 50/30/20" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="Percentages of planned take-home — not measured spending. Car and medical funds are future needs; parents' allowance is a need; the subscription is a want. Buffer stays separate." Style="{StaticResource SecondaryTextStyle}" />
                                    <ItemsControl ItemsSource="{x:Bind Planning.Shares}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PlanningShareRow">
                                                <Grid Margin="0,8" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Name}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Amount}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Percent}" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{x:Bind Planning.SurplusRuleText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Still to confirm · not zero" Style="{StaticResource SectionTitleStyle}" />
                                    <ItemsControl ItemsSource="{x:Bind Planning.Unknowns}">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,4" Style="{StaticResource SecondaryTextStyle}" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{x:Bind Planning.ActualDeductionsText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource AppWarningBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource CardStyle}" BorderBrush="{ThemeResource AppWarningBrush}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Planning cautions &amp; payday checks" Style="{StaticResource SectionTitleStyle}" />
                                <ItemsControl ItemsSource="{x:Bind Planning.Warnings}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,5" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Expander Header="Update estimates or supply a real payslip" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="18" Padding="6">
                                <TextBlock Text="Leave anything not supplied blank. Saving this form updates planning only — it never records a bank deposit or expense. Your original comparison and earlier plan versions are retained privately." Style="{StaticResource SecondaryTextStyle}" />
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <NumberBox Header="Full-month take-home estimate" Value="{x:Bind Planning.FullMonthEstimate, Mode=TwoWay}" Minimum="0" />
                                    <NumberBox Grid.Column="1" Header="First-month cautious envelope" Value="{x:Bind Planning.FirstMonthEstimate, Mode=TwoWay}" Minimum="0" />
                                    <NumberBox Grid.Column="2" Header="Proposed subscription (estimate)" Value="{x:Bind Planning.ProposedSubscription, Mode=TwoWay}" Minimum="0" />
                                </Grid>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox Content="First payday is now confirmed" IsChecked="{x:Bind Planning.FirstPaydayKnown, Mode=TwoWay}" />
                                    <DatePicker Grid.Column="1" Header="First payday (ignored unless confirmed)" Date="{x:Bind Planning.FirstPayday, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox Content="Subscription change is confirmed" IsChecked="{x:Bind Planning.SubscriptionConfirmed, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1" Header="Actual subscription bill" Value="{x:Bind Planning.ConfirmedSubscription, Mode=TwoWay}" Minimum="0" />
                                    <DatePicker Grid.Column="2" Header="Subscription effective month" Date="{x:Bind Planning.SubscriptionFrom, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock Text="Actual payslip figures — not salary estimates" Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox Content="This is a received full-month payslip (use its net pay for full-month planning)" IsChecked="{x:Bind Planning.PayslipIsFullMonth, Mode=TwoWay}" />
                                <Grid ColumnSpacing="14" RowSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <NumberBox Header="Actual gross pay" Value="{x:Bind Planning.ActualGrossPay, Mode=TwoWay}" Minimum="0" />
                                    <NumberBox Grid.Column="1" Header="Actual take-home pay" Value="{x:Bind Planning.ActualTakeHome, Mode=TwoWay}" Minimum="0" />
                                    <NumberBox Grid.Column="2" Header="EPF (actual)" Value="{x:Bind Planning.ActualEpf, Mode=TwoWay}" Minimum="0" />
                                    <NumberBox Grid.Column="3" Header="SOCSO (actual)" Value="{x:Bind Planning.ActualSocso, Mode=TwoWay}" Minimum="0" />
                                    <NumberBox Grid.Row="1" Header="EIS (actual)" Value="{x:Bind Planning.ActualEis, Mode=TwoWay}" Minimum="0" />
                                    <NumberBox Grid.Row="1" Grid.Column="1" Header="PCB (actual)" Value="{x:Bind Planning.ActualPcb, Mode=TwoWay}" Minimum="0" />
                                    <NumberBox Grid.Row="1" Grid.Column="2" Header="Payslip zakat (actual)" Value="{x:Bind Planning.ActualZakat, Mode=TwoWay}" Minimum="0" />
                                    <NumberBox Grid.Row="1" Grid.Column="3" Header="Other deductions (actual)" Value="{x:Bind Planning.ActualOtherDeductions, Mode=TwoWay}" Minimum="0" />
                                </Grid>
                                <Button Content="Save private planning changes" Click="SavePlanning_Click" IsEnabled="{x:Bind Planning.HasProfile, Mode=OneWay}" Style="{StaticResource PrimaryActionButtonStyle}" />
                                <TextBlock Text="{x:Bind Planning.StatusText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="Estimates and history stay in your local app-data folder, separate from the public source and portable app. Treat these files as private; they are not encrypted." Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Transactions -->
            <ScrollViewer x:Name="TransactionsView" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" SizeChanged="ActivityView_SizeChanged">
                <Grid x:Name="ActivityContent" Width="1000" MinWidth="760" MaxWidth="1160" Margin="30,4,34,28" RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Expander x:Name="TransactionEntryExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="{x:Bind ViewModel.TransactionFormTitle, Mode=OneWay}">
                        <StackPanel Spacing="12" Width="620" HorizontalAlignment="Left">
                            <Border
                                Padding="12"
                                Background="{ThemeResource AppAccentSoftBrush}"
                                BorderBrush="{ThemeResource AppAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                                            Text="{x:Bind ViewModel.TodayHeadingText, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                                            Text="New entries use this PC-local day by default." />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Set transaction date to today"
                                        Click="UseToday_Click"
                                        Content="Use today" />
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ComboBox Header="Type" HorizontalAlignment="Stretch" DisplayMemberPath="Label" ItemsSource="{x:Bind ViewModel.TransactionTypes}" SelectedItem="{x:Bind ViewModel.SelectedTransactionType, Mode=TwoWay}" />
                                <DatePicker Grid.Column="1" Header="Date (backdating is okay)" Date="{x:Bind ViewModel.TransactionDate, Mode=TwoWay}" />
                                <NumberBox Grid.Row="1" Header="Amount" Minimum="0" PlaceholderText="0.00" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.TransactionAmount, Mode=TwoWay}" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Header="Category" HorizontalAlignment="Stretch" DisplayMemberPath="Name" IsEnabled="{x:Bind ViewModel.IsTransactionCategoryEnabled, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.AvailableTransactionCategories}" SelectedItem="{x:Bind ViewModel.SelectedTransactionCategory, Mode=TwoWay}" />
                            </Grid>
                            <ComboBox
                                Header="Savings goal"
                                DisplayMemberPath="Label"
                                ItemsSource="{x:Bind ViewModel.SavingsDestinations}"
                                SelectedItem="{x:Bind ViewModel.SelectedSavingsDestination, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.SavingsDestinationVisibility, Mode=OneWay}" />
                            <TextBox Header="Note" MaxLength="180" PlaceholderText="e.g. Groceries at the market" Text="{x:Bind ViewModel.TransactionNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource PrimaryActionButtonStyle}" Command="{x:Bind ViewModel.AddTransactionCommand}" Content="{x:Bind ViewModel.TransactionSubmitText, Mode=OneWay}" />
                                <Button
                                    x:Name="CancelTransactionEditButton"
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.CancelTransactionEditCommand}"
                                    Content="Cancel"
                                    Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="This month's activity" />
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.TransactionCountText, Mode=OneWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10"><Button Click="ImportStatement_Click" Content="Import Maybank statement" /><Button Click="ExportCsv_Click" Content="Export CSV" /></StackPanel>
                            <TextBlock Visibility="{x:Bind ViewModel.EmptyTransactionsVisibility, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Text="No transactions for this month yet." />
                            <ListView ItemsSource="{x:Bind ViewModel.Transactions}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="64" Padding="4,7" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{Binding DateText}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding Note}" />
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding TypeText}" />
                                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="·" />
                                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding CategoryName}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding AmountText}" />
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                                <Button
                                                    Tag="{Binding Id}"
                                                    AutomationProperties.Name="Edit transaction"
                                                    Click="EditTransaction_Click"
                                                    Content="{Binding ActionText}"
                                                    ToolTipService.ToolTip="Edit transaction" />
                                                <Button
                                                    Tag="{Binding Id}"
                                                    AutomationProperties.Name="Delete transaction"
                                                    Click="DeleteTransaction_Click"
                                                    IsEnabled="{Binding CanDelete}"
                                                    ToolTipService.ToolTip="Delete transaction">
                                                    <SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Bills -->
            <ScrollViewer x:Name="BillsView" Grid.Row="1" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed" SizeChanged="BillsView_SizeChanged">
                <Grid x:Name="BillsContent" MinWidth="760" Width="1000" MaxWidth="1160" Margin="30,4,34,28" RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Expander x:Name="BillEntryExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="{x:Bind ViewModel.BillFormTitle, Mode=OneWay}">
                        <StackPanel Spacing="12" Width="620" HorizontalAlignment="Left">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                Text="Create a schedule once, then check off each month when it is paid."
                                TextWrapping="Wrap" />
                            <TextBox Header="Bill name" MaxLength="80" PlaceholderText="e.g. Internet" Text="{x:Bind ViewModel.BillName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <NumberBox Header="Monthly amount" Minimum="0" PlaceholderText="0.00" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.BillAmount, Mode=TwoWay}" />
                                <NumberBox Grid.Column="1" Header="Due day" Minimum="1" Maximum="31" SmallChange="1" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.BillDueDay, Mode=TwoWay}" />
                            </Grid>
                            <ComboBox Header="Category" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.BillCategoryOptions}" SelectedItem="{x:Bind ViewModel.SelectedBillCategory, Mode=TwoWay}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Command="{x:Bind ViewModel.AddBillCommand}"
                                    Content="{x:Bind ViewModel.BillSubmitText, Mode=OneWay}" />
                                <Button
                                    x:Name="CancelBillEditButton"
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.CancelBillEditCommand}"
                                    Content="Cancel"
                                    Visibility="Collapsed" />
                            </Grid>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="A bill due on day 29–31 automatically moves to the last valid day in shorter months." />
                        </StackPanel>
                    </Expander>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind ViewModel.BillsHeadingText, Mode=OneWay}" />
                            <Border Padding="14" Background="{ThemeResource AppAccentSoftBrush}" BorderBrush="{ThemeResource AppAccentBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" TextWrapping="Wrap" Text="{x:Bind ViewModel.BillsCompletionText, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.NextBillText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Mark as paid uses today's PC-local date for the month shown above. This is a checklist only; record the expense in Activity if needed. Use the month arrows to check off a future bill early or review earlier payments." />
                            <TextBlock Visibility="{x:Bind ViewModel.EmptyBillsVisibility, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Text="No bills are scheduled for this month." />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Bills}" IsEnabled="{x:Bind ViewModel.CanManageBills, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="2,16" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <FontIcon VerticalAlignment="Top" Margin="0,3,0,0" FontSize="17" Glyph="&#xE73E;" Foreground="{ThemeResource AppAccentBrush}" Visibility="{Binding PaidVisibility}" />
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" TextWrapping="Wrap" Text="{Binding Name}" />
                                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding CategoryName}" />
                                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding DueText}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Top" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding AmountText}" />
                                                </Grid>
                                                <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" TextWrapping="Wrap" Text="{Binding CountdownText}" />
                                                <TextBlock Visibility="{Binding NextDueVisibility}" Style="{StaticResource SecondaryTextStyle}" Text="{Binding NextDueText}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Tag="{Binding}" AutomationProperties.Name="{Binding PaymentActionName}" Click="ToggleBillPayment_Click" Content="{Binding PaymentActionText}" />
                                                    <Button Tag="{Binding Id}" AutomationProperties.Name="Edit recurring bill" Click="EditBill_Click" Content="Edit" ToolTipService.ToolTip="Edit bill" />
                                                    <Button Tag="{Binding Id}" AutomationProperties.Name="Delete recurring bill" Click="DeleteBill_Click" ToolTipService.ToolTip="Delete bill"><SymbolIcon Symbol="Delete" /></Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Goals -->
            <ScrollViewer x:Name="GoalsView" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" SizeChanged="GoalsView_SizeChanged">
                <Grid x:Name="GoalsContent" Width="1000" MinWidth="760" MaxWidth="1160" Margin="30,4,34,28" RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="+ Create a savings goal">
                        <StackPanel Spacing="12" Width="620" HorizontalAlignment="Left">
                            <TextBox Header="Goal name" MaxLength="80" PlaceholderText="e.g. Emergency fund" Text="{x:Bind ViewModel.GoalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <NumberBox Header="Target amount" Minimum="0" PlaceholderText="0.00" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.GoalTargetAmount, Mode=TwoWay}" />
                            <NumberBox Header="Starting amount" Minimum="0" PlaceholderText="0.00" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.GoalCurrentAmount, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="New savings transactions can be linked to this goal. Editing or deleting them updates progress automatically." />
                            <DatePicker Header="Target date" Date="{x:Bind ViewModel.GoalTargetDate, Mode=TwoWay}" />
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource PrimaryActionButtonStyle}" Command="{x:Bind ViewModel.AddGoalCommand}" Content="Add savings goal" />
                        </StackPanel>
                    </Expander>
                    <StackPanel Grid.Row="1" Spacing="12">
                        <TextBlock Visibility="{x:Bind ViewModel.EmptyGoalsVisibility, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Text="No savings goals yet. Start with one goal that matters to you." />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Goals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="12">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding DueText}" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                                    <Button Tag="{Binding Id}" AutomationProperties.Name="Add money to savings goal" Click="AddMoneyToGoal_Click" Content="Add money" />
                                                    <Button Tag="{Binding Id}" AutomationProperties.Name="Delete savings goal" Click="DeleteGoal_Click" ToolTipService.ToolTip="Delete goal"><SymbolIcon Symbol="Delete" /></Button>
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Height="9" Maximum="100" Value="{Binding PercentComplete}" />
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding CurrentText}" />
                                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding TargetText}" />
                                                </StackPanel>
                                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" Text="{Binding PercentText}" />
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding StartingText}" />
                                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" Text="{Binding ContributionText}" />
                                            </Grid>
                                            <TextBlock FontSize="11" Foreground="{ThemeResource AppAccentBrush}" Text="{Binding MonthContributionText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>



            <!-- Reports -->
            <ScrollViewer x:Name="ReportsView" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Margin="30,4,34,28" Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="7"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="MONTHLY INCOME" /><TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{x:Bind ViewModel.IncomeText, Mode=OneWay}" /></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="7"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="MONTHLY SPENDING" /><TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource AppDangerBrush}" Text="{x:Bind ViewModel.SpentText, Mode=OneWay}" /></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="7"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="MONTHLY SAVINGS" /><TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" Text="{x:Bind ViewModel.SavedText, Mode=OneWay}" /></StackPanel></Border>
                    </Grid>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Six-month snapshot" />
                            <Grid Padding="4,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="MONTH" /><TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="INCOME" /><TextBlock Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" Text="SPENT" /><TextBlock Grid.Column="3" Style="{StaticResource SecondaryTextStyle}" Text="SAVED" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.MonthlyTrend}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,9" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding MonthText}" />
                                            <TextBlock Grid.Column="1" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding IncomeText}" />
                                            <TextBlock Grid.Column="2" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding SpentText}" />
                                            <TextBlock Grid.Column="3" Foreground="{ThemeResource AppAccentBrush}" Text="{Binding SavedText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Category breakdown" /><Button HorizontalAlignment="Right" Click="ExportCsv_Click" Content="Export month to CSV" /></Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="{Binding ActualText}" />
                                            <ProgressBar Grid.Column="2" Height="7" VerticalAlignment="Center" Maximum="100" Value="{Binding ProgressPercent}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Width="760" Margin="30,4,34,28" HorizontalAlignment="Left" Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Appearance &amp; currency" />
                            <ToggleSwitch x:Name="SettingsThemeToggle" AutomationProperties.Name="Use dark mode" Header="Dark mode" IsOn="{x:Bind ViewModel.IsDarkMode, Mode=OneWay}" OffContent="Light" OnContent="Dark" Toggled="SettingsThemeToggle_Toggled" />
                            <ComboBox Width="260" HorizontalAlignment="Left" Header="Currency" ItemsSource="{x:Bind ViewModel.CurrencyCodes}" SelectedItem="{x:Bind ViewModel.CurrencyCode, Mode=TwoWay}" />
                            <Button HorizontalAlignment="Left" Style="{StaticResource PrimaryActionButtonStyle}" Command="{x:Bind ViewModel.SaveSettingsCommand}" Content="Save preferences" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Your local data" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Your budget stays on this PC. No ads, telemetry or bank login. Nothing is sent to Notion unless you preview and send a monthly summary yourself." />
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="Database location" />
                            <TextBox IsReadOnly="True" Text="{x:Bind ViewModel.DatabasePath}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="Backup_Click" Content="Create backup" />
                                <Button Click="ExportCsv_Click" Content="Export this month" />
                                <Button Click="ImportCsv_Click" Content="Import CSV" />
                                <Button Click="ImportStatement_Click" Content="Import Maybank PDF" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Expander Header="Notion · Monthly summaries" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Optional, one-way sharing. Only the selected month's totals and bill-completion count are sent. Purchases, account numbers, statement PDFs, goals and your private future plan stay on this PC." />
                            <TextBlock Text="1. Create an internal Notion connection with read, insert and update content permissions. 2. Add it to a dedicated parent page using Connections in that page's menu. 3. Enter its token below, never in GitHub or chat." TextWrapping="Wrap" />
                            <HyperlinkButton Content="Notion connection setup guide" NavigateUri="https://www.notion.com/help/create-integrations-with-the-notion-api" HorizontalAlignment="Left"/>
                            <TextBox x:Name="NotionParentPage" Header="Parent page link or ID" PlaceholderText="https://www.notion.so/..."/>
                            <PasswordBox x:Name="NotionToken" Header="Internal connection token" PlaceholderText="Stored encrypted for your Windows user"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Save connection" Click="SaveNotion_Click"/>
                                <Button x:Name="NotionPreviewButton" Content="Preview monthly summary" Click="PreviewNotion_Click"/>
                                <Button Content="Forget connection" Click="ForgetNotion_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="NotionStatus" Text="Not connected. You can still preview a monthly summary." TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Statement imports &amp; legacy investment records" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Maybank savings/current-account PDFs in the supported signed-amount layout are read locally. Every running balance and final total must match. Scanned PDFs and credit-card statements are not supported. Review transfers and any income already posted by your schedule before importing."/>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Investment tracking is no longer in the daily interface because a supported automatic holdings connection is not available. Existing records and savings links are preserved in your local database and backups; nothing was deleted."/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Explore with example data" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Load a synthetic sample only when this month is empty. It never overwrites existing entries." />
                            <Button HorizontalAlignment="Left" Command="{x:Bind ViewModel.SeedDemoDataCommand}" Content="Load example budget" />
                        </StackPanel>
                    </Expander>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="About MyBudget" />
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Text="Personal Finance and Budget Analytics Application" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Created by KhaiFaw. Free for personal and other non-commercial use. Redistribution, modification, or commercial use requires prior written permission." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Margin="30,8,34,16" Background="{ThemeResource AppSurfaceMutedBrush}" CornerRadius="10" Padding="12,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xE73E;" />
                        <TextBlock Foreground="{ThemeResource AppTextSecondaryBrush}" Text="{x:Bind ViewModel.LocalSaveText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.StatusErrorVisibility, Mode=OneWay}">
                        <SymbolIcon Foreground="{ThemeResource AppDangerBrush}" Symbol="Important" />
                        <TextBlock Foreground="{ThemeResource AppDangerBrush}" Text="Needs attention" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </NavigationView>
</Page>
